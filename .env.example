# Series ID to watch
POLYMARKET_SERIES_ID=10365

# App environment.
APP_ENV=dev

# S3-compatible storage config used by src/s3_storage.py
# Copy this file to .env and fill in real values.
# For local dev against the docker-compose MinIO service, see docker-compose.yaml (profile "dev").

# Endpoint URL of the S3-compatible service. Leave unset to use AWS S3 default endpoint.
# Use http://minio:9000 if the app itself runs inside docker-compose (Docker network hostname).
# Use http://localhost:9000 if running main.py directly on the host against the mapped MinIO port.
S3_ENDPOINT_URL=http://minio:9000

# Bucket to write flushed message batches to. Created automatically if missing.
S3_BUCKET=poly-orderbook-data

# Credentials for the S3-compatible service.
# Local MinIO defaults (see docker-compose.yaml): admin / admin123
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=admin123
